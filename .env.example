# MacroAgent API key template — copy to `.env` (gitignored) and fill in.
# In production (Render/Railway) set these as dashboard env vars instead of a file.

# --- Required for the v2 app (macroagent_app.py) ---
FRED_API_KEY="your_key_here"          # STRATEGY: live Fed macro data
GOOGLE_API_KEY="your_key_here"        # STRATEGY: Gemini memo + chat
ALPACA_API_KEY="your_key_here"        # EXECUTION: paper trading + symbol directory
ALPACA_SECRET_KEY="your_key_here"     # EXECUTION: paper trading

# --- Auth (optional; magic-link login via Supabase) ---
# From your Supabase project: Settings -> API. The anon key is public by design
# (protected by row-level security), so it's safe as an env var. Leave both blank
# to run the app with login disabled (anonymous-only).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# --- Optional ---
# Signs NiceGUI session storage (required for login sessions to persist).
# Render auto-generates this; locally a dev fallback is used if unset.
NICEGUI_STORAGE_SECRET=""

# --- Legacy (v1 app1.py only; v2 uses yfinance for the SPY quote instead) ---
ALPHA_VANTAGE_API_KEY="your_key_here"
